rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for the dashboard. Clients never write: all writes go through
    // the Cloud Functions (admin SDK), which bypass these rules. The Firebase web
    // API key is public, so "any signed-in user" is not a meaningful gate.
    match /knowledge_base/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
